---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/sections/Faq.astro';
import Journey from '../components/sections/Journey.astro';
import Register from '../components/sections/Register.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import AgeRange from '../components/ui/AgeRange.astro';
import Icon from '../components/ui/Icon.astro';
import MediaSlot from '../components/ui/MediaSlot.astro';
import MedalEmblem from '../components/ui/MedalEmblem.astro';
import WhatsAppButton from '../components/ui/WhatsAppButton.astro';
import { site } from '../config/site';
import { getTrack, tracks, type TrackSlug } from '../data/tracks';
import { getCopy, localizePath, type Locale } from '../i18n';
import { trackJsonLd } from '../lib/schema';

interface Props {
  locale: Locale;
  slug: TrackSlug;
}

const { locale, slug } = Astro.props;
const t = getCopy(locale);
const track = getTrack(slug);
const copy = t.tracks[slug];
const dark = track.depth === 'deep';
const others = tracks.filter((other) => other.slug !== slug);
const siteUrl = Astro.site ?? new URL('https://kayaswim.example');
const path = `/tracks/${slug}/`;
---

<BaseLayout locale={locale} path={path} title={copy.meta.title} description={copy.meta.description} jsonLd={trackJsonLd(slug, locale, siteUrl)}>
  <section class="track-hero pt-6 pb-16 lg:pt-8 lg:pb-24" aria-labelledby="track-title" data-hero>
    <div class="wrap">
      <a href={localizePath('/#tracks', locale)} class="link-forward min-h-11 text-ink-2!">
        <Icon name="back" size={18} />
        {t.trackPage.allTracks}
      </a>

      <div class="mt-4 grid gap-5 lg:grid-cols-[minmax(0,6fr)_minmax(0,5fr)] lg:items-stretch lg:gap-6">
        <div
          class:list={[`depth-${track.depth}`, 'track-lane contrast-border relative isolate flex flex-col overflow-hidden rounded-card', dark && 'on-dark']}
          style={`view-transition-name: lane-${slug}; view-transition-class: lane`}
        >
          <span class="caustics" aria-hidden="true"></span>
          <p class="relative">
            <span class="block text-[0.9375rem] font-semibold opacity-80">{t.tracksSection.agesPrefix}</span>
            <span class="track-figure num block font-display">
              <AgeRange min={track.ages[0]} max={track.ages[1]} />
            </span>
          </p>
          <h1 id="track-title" class="track-title relative mt-6">{copy.name}</h1>
          <p class="track-tagline relative mt-3">{copy.tagline}</p>
          <p class="track-pitch relative mt-4">{copy.pitch}</p>
          {copy.price && <p class="relative mt-5 text-xl font-semibold">{copy.price}</p>}
          <div class="relative mt-auto flex flex-wrap items-center gap-x-6 gap-y-4 pt-10">
            <WhatsAppButton locale={locale} message={copy.whatsapp} cta={`track-page-${slug}`} size="lg" class="max-sm:w-full" />
            <a href="#register" class="link-forward track-link">
              {t.nav.contact}
              <Icon name="forward" size={18} />
            </a>
          </div>
        </div>

        <MediaSlot
          slot={track.image}
          alt={copy.imageAlt}
          aspect="4 / 3"
          sizes="(min-width: 1024px) 45vw, 100vw"
          priority
          depth={dark ? 'shallow' : 'deep'}
          class="rounded-card lg:aspect-auto! lg:h-full"
        />
      </div>
    </div>
  </section>

  <section class="section-pad bg-paper-2" aria-label={copy.name}>
    <div class="wrap grid gap-16 md:grid-cols-2 md:gap-16">
      {
        [
          { title: t.trackPage.forWhom, items: copy.forWhom },
          { title: t.trackPage.whatYouGet, items: copy.whatYouGet },
        ].map((list) => (
          <div>
            <h2 class="head-section reveal">{list.title}</h2>
            <ul class="ruled mt-8">
              {list.items.map((item, index) => (
                <li class="reveal flex items-start gap-3 py-4 text-lg" style={`--reveal-at: ${index * 5}%`}>
                  <Icon name="check" size={20} strokeWidth={2.25} class="mt-1 text-accent" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="on-dark section-pad-s bg-abyss text-light" aria-labelledby="with-founder-title">
    <div class="reveal wrap grid items-center gap-8 md:grid-cols-[auto_minmax(0,1fr)] md:gap-14">
      <MedalEmblem disc class="size-28 md:size-36" />
      <div>
        <h2 id="with-founder-title" class="head-section">{t.trackPage.withFounder}</h2>
        <p class="mt-4 max-w-3xl text-lg text-shade">
          <strong class="font-semibold text-light">{site.founder[locale].full}</strong>, {t.trackPage.withFounderText}
        </p>
        <a href={localizePath('/#story', locale)} class="link-forward mt-6 text-light!">
          {t.trackPage.storyLink}
          <Icon name="forward" size={18} />
        </a>
      </div>
    </div>
  </section>

  <Journey locale={locale} />
  <Testimonials locale={locale} track={slug} title={t.trackPage.testimonials} />
  <Faq locale={locale} track={slug} title={t.trackPage.faq} class="pt-0" />

  <section class="pb-(--section-gap)" aria-labelledby="other-tracks-title">
    <div class="wrap">
      <h2 id="other-tracks-title" class="head-section reveal">{t.trackPage.otherTracks}</h2>
      <ul class="mt-10 grid gap-4 md:grid-cols-2">
        {
          others.map((other, index) => (
            <li class="reveal" style={`--reveal-at: ${index * 6}%`}>
              <a
                href={localizePath(`/tracks/${other.slug}/`, locale)}
                class:list={[
                  `depth-${other.depth}`,
                  'other-lane contrast-border group relative isolate flex items-center justify-between gap-6 overflow-hidden rounded-card p-6 sm:p-8',
                  other.depth === 'deep' && 'on-dark',
                ]}
                style={`view-transition-name: lane-${other.slug}; view-transition-class: lane`}
                data-astro-prefetch
              >
                <span class="caustics" aria-hidden="true" />
                <span class="relative">
                  <span class="num block font-display text-5xl leading-none font-light">
                    <AgeRange min={other.ages[0]} max={other.ages[1]} />
                  </span>
                  <span class="mt-3 block text-title font-display">{t.tracks[other.slug].name}</span>
                </span>
                <Icon name="forward" size={26} class="other-arrow relative" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Register locale={locale} defaultTrack={slug} />
</BaseLayout>

<style>
  .track-lane {
    padding: var(--space-lg);
  }

  @media (width >= 40rem) {
    .track-lane {
      padding: var(--space-2xl);
    }
  }

  .track-figure {
    font-size: var(--text-figure);
    font-weight: 300;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .track-title {
    font-size: var(--text-display);
    max-width: 16ch;
  }

  .track-tagline {
    font-size: var(--text-lead);
    font-weight: 600;
  }

  .track-pitch {
    max-width: 50ch;
    font-size: 1.0625rem;
    color: var(--color-ink-2);
  }

  .depth-deep .track-pitch {
    color: var(--color-shade);
  }

  .depth-deep .track-link {
    color: var(--color-light);
  }

  .ruled {
    border-top: 1px solid var(--color-rule);
  }

  .ruled li {
    border-bottom: 1px solid var(--color-rule);
  }

  .other-lane :global(.other-arrow) {
    transition: translate var(--dur-short) var(--ease-out);
  }

  .other-lane:active {
    scale: 0.99;
  }

  @media (hover: hover) and (pointer: fine) {
    .other-lane:hover :global(.other-arrow) {
      translate: calc(var(--dir, 1) * 6px) 0;
    }
  }
</style>
