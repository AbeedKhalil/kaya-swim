---
import Icon from '../ui/Icon.astro';
import MedalEmblem from '../ui/MedalEmblem.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<!-- The honours board at the pool's edge: plain facts parted by hairlines, bronze kept for the medal. -->
<div class="wrap">
  <ul class="honours">
    {
      t.credentials.map((item, index) => (
        <li class:list={['honour reveal', item.medal && 'honour--medal']} style={`--reveal-at: ${index * 5}%`}>
          {item.medal ? (
            <MedalEmblem disc uid="honours" class="honour-medal" />
          ) : (
            <Icon name={item.icon} size={22} strokeWidth={2} class="text-accent" />
          )}
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  /* The honours board: five plain facts in full ink, the medal the one thing in bronze. */
  .honours {
    display: grid;
    margin-top: var(--space-lg);
    border-block: 1.5px solid var(--color-ink);
  }

  .honour {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    min-height: 3.5rem;
    padding-block: var(--space-sm);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .honour :global(svg) {
    flex-shrink: 0;
  }

  .honour :global(.honour-medal) {
    width: 1.75rem;
    height: 1.75rem;
    margin-inline: -0.2rem;
    filter: drop-shadow(var(--drop-shadow-medal));
  }

  .honour + .honour {
    border-top: 1px solid var(--color-rule);
  }

  .honour--medal {
    color: var(--color-bronze);
    font-weight: 700;
  }

  @media (width >= 64rem) {
    .honours {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .honours {
      margin-top: var(--space-xl);
    }

    .honour {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-xs);
      padding-block: var(--space-lg);
      padding-inline: 0 var(--space-lg);
    }

    .honour + .honour {
      border-top: 0;
      border-inline-start: 1px solid var(--color-rule);
      padding-inline-start: var(--space-lg);
    }
  }
</style>
