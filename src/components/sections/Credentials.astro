---
import Icon from '../ui/Icon.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<!-- The pool floor under the hero: an honours board, bronze reserved for the medal. -->
<div class="bg-abyss text-white">
  <ul class="wrap grid gap-3 py-7 text-[0.95rem] font-semibold lg:grid-cols-5 lg:gap-0 lg:py-9">
    {
      t.credentials.map((item, index) => (
        <li
          class:list={['credential reveal flex items-center gap-2.5', item.medal && 'text-bronze-light']}
          style={`--reveal-at: ${index * 6}%`}
        >
          <Icon name={item.icon} size={20} strokeWidth={2} class={item.medal ? 'text-bronze-light' : 'text-pool'} />
          <span class:list={[item.medal && 'medal-glint']}>{item.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  @media (width >= 64rem) {
    .credential {
      flex-direction: column;
      justify-content: flex-start;
      gap: 0.75rem;
      padding-inline: 1.25rem;
      text-align: center;
      line-height: 1.4;
    }

    .credential + .credential {
      border-inline-start: 1px solid rgb(255 255 255 / 0.12);
    }
  }

  /* A glint sweeps across the medal line as it scrolls into view. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(html:not(.a11y-still)) .medal-glint {
        background: linear-gradient(110deg, var(--color-bronze-light) 42%, #fff4e2 50%, var(--color-bronze-light) 58%) 0 0 / 300% 100%;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: medal-glint linear both;
        animation-timeline: view();
        animation-range: entry 60% cover 70%;
      }
    }
  }

  @keyframes medal-glint {
    from {
      background-position: 100% 0;
    }
    to {
      background-position: 0 0;
    }
  }

  :global(html.a11y-contrast) .medal-glint {
    background: none;
    color: inherit;
  }
</style>
