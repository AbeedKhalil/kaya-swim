---
import Icon from '../ui/Icon.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<!-- The honours board at the pool's edge: plain facts parted by hairlines, bronze kept for the medal. -->
<div class="wrap">
  <ul class="honours">
    {
      t.credentials.map((item, index) => (
        <li class:list={['honour reveal', item.medal && 'honour--medal']} style={`--reveal-at: ${index * 5}%`}>
          <Icon name={item.icon} size={20} strokeWidth={1.75} class={item.medal ? 'text-bronze' : 'text-accent'} />
          <span>{item.text}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .honours {
    display: grid;
    border-block: 1px solid var(--color-rule);
  }

  .honour {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    padding-block: var(--space-md);
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .honour :global(svg) {
    margin-top: 0.1em;
  }

  .honour + .honour {
    border-top: 1px solid var(--color-rule-2);
  }

  .honour--medal {
    color: var(--color-bronze);
    font-weight: 600;
  }

  @media (width >= 64rem) {
    .honours {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .honour {
      flex-direction: column;
      gap: var(--space-xs);
      padding-block: var(--space-lg);
      padding-inline: 0 var(--space-lg);
    }

    .honour + .honour {
      border-top: 0;
      border-inline-start: 1px solid var(--color-rule-2);
      padding-inline-start: var(--space-lg);
    }
  }
</style>
