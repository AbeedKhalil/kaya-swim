---
import type { TrackSlug } from '../../data/tracks';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Show only testimonials about this track. */
  track?: TrackSlug;
  title?: string;
  class?: string;
}

const { locale, track, title, class: className } = Astro.props;
const t = getCopy(locale);
const s = t.testimonials;
const items = track ? s.items.filter((item) => item.track === track) : s.items;
const heading = title ?? s.title;
---

{
  items.length > 0 && (
    <section id="testimonials" class:list={['section-pad', className]} aria-labelledby="testimonials-title">
      <div class="wrap">
        <h2 id="testimonials-title" class="head-section reveal">
          {heading}
        </h2>
        <div class="voices reveal mt-10 md:mt-12" role="region" aria-label={s.regionLabel} tabindex="0">
          <ul class="voices-list">
            {items.map((item) => (
              <li class="voice">
                <figure class="flex h-full flex-col">
                  {item.sample && <span class="sample-stamp">{s.sampleBadge}</span>}
                  <blockquote class="voice-quote font-display">
                    <p>{item.quote}</p>
                  </blockquote>
                  <figcaption class="mt-auto pt-8 text-[0.9375rem]">
                    <span class="block font-semibold">{item.name}</span>
                    <span class="mt-1 block text-muted">
                      {s.audiences[item.audience]}, {t.tracks[item.track].name}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  )
}

<style>
  .voices-list {
    display: flex;
    gap: var(--space-md);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    margin-inline: calc(var(--gutter) * -1);
    padding: var(--space-2xs) var(--gutter) var(--space-md);
    scrollbar-width: thin;
  }

  .voice {
    position: relative;
    flex: 0 0 min(85%, 24rem);
    scroll-snap-align: start;
    padding: var(--space-lg);
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    box-shadow: inset 0 0 0 1px var(--color-rule-2);
  }

  .voice-quote {
    font-size: 1.25rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .voice-quote:lang(he) {
    quotes: '\201D' '\201D';
  }

  .voice-quote:lang(en) {
    quotes: '\201C' '\201D';
  }

  .voice-quote p::before {
    content: open-quote;
  }

  .voice-quote p::after {
    content: close-quote;
  }

  /* An honest mark on placeholder quotes: a small inked stamp, not a badge. */
  .sample-stamp {
    align-self: flex-start;
    margin-bottom: var(--space-md);
    padding: var(--space-2xs) var(--space-sm);
    border: 1.5px dashed var(--color-muted);
    border-radius: var(--space-xs);
    color: var(--color-ink-2);
    font-size: var(--text-sm);
    font-weight: 600;
    rotate: -3deg;
  }

  :global([dir='rtl']) .sample-stamp {
    rotate: 3deg;
  }

  @media (width >= 48rem) {
    .voices-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-lg);
      overflow: visible;
      margin-inline: 0;
      padding: 0;
    }

    .voice {
      padding: var(--space-xl);
    }

    .voice-quote {
      font-size: 1.5rem;
    }
  }
</style>
