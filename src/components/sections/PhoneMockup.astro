---
/**
 * The joining journey as a WhatsApp thread, shown as a clear panel lying on the
 * page (no device frame): first message → reply → payment details → digital
 * receipt → lesson video. Decorative for screen readers (the steps beside it
 * carry the content). Bubbles arrive as the steps list scrolls past (--journey).
 */
import Icon from '../ui/Icon.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const p = getCopy(Astro.props.locale).journey.phone;
---

<figure class="chat-figure mx-auto w-full max-w-[24rem]">
  <div class="chat-panel clear" aria-hidden="true">
    <div class="chat-head flex items-center gap-3 px-4 py-3">
      <span class="grid size-10 place-items-center rounded-full bg-light font-display text-xl text-deep" dir="ltr">K</span>
      <span class="leading-tight">
        <span class="block font-semibold" dir="ltr">{p.contact}</span>
        <span class="block text-sm opacity-80">{p.status}</span>
      </span>
    </div>

    <div class="chat grid gap-2.5 p-3 text-[0.9375rem] leading-snug sm:p-4">
      <p class="bubble bubble-out" style="--i: 0">{p.outgoing}</p>
      <p class="bubble bubble-in" style="--i: 1">{p.reply}</p>

      <div class="bubble bubble-in flex items-center gap-3" style="--i: 2">
        <span class="chat-icon"><Icon name="receipt" size={20} /></span>
        <span>
          <span class="block font-semibold">{p.payment.title}</span>
          <span class="block text-sm text-muted">{p.payment.text}</span>
        </span>
      </div>

      <div class="bubble bubble-in flex items-center gap-3" style="--i: 3">
        <span class="chat-icon"><Icon name="file-text" size={20} /></span>
        <span class="font-semibold">{p.receipt}</span>
        <Icon name="circle-check" size={18} class="ms-auto text-accent" />
      </div>

      <div class="bubble bubble-in w-[85%] p-1.5!" style="--i: 4">
        <span class="video pool relative block aspect-video overflow-hidden rounded-(--radius-inner)">
          <span class="caustics"></span>
          <span class="absolute inset-0 grid place-items-center">
            <span class="grid size-11 place-items-center rounded-full bg-light/90 text-deep">
              <Icon name="play" size={20} strokeWidth={2.25} class="translate-x-px" />
            </span>
          </span>
        </span>
        <span class="block px-1.5 pt-2 pb-1">
          <span class="block font-semibold">{p.video.title}</span>
          <span class="block text-sm text-muted">{p.video.text}</span>
        </span>
      </div>
    </div>
  </div>
  <figcaption class="sr-only">{p.label}</figcaption>
</figure>

<style>
  .chat-panel {
    overflow: hidden;
    box-shadow: var(--edge-light), var(--shadow-cast);
  }

  .chat-head {
    background: var(--color-deep);
    color: var(--color-light);
  }

  .chat {
    background: color-mix(in oklab, var(--color-shade) 30%, var(--color-paper));
  }

  .chat-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-inner);
    background: var(--color-accent-soft);
    color: var(--color-accent-hi);
  }

  .bubble {
    max-width: 85%;
    padding: 0.55rem 0.75rem;
    border-radius: 0.9rem;
    background: var(--color-light);
    color: var(--color-ink);
    box-shadow: 0 1px 1px oklch(30% 0.05 235 / 0.08);
  }

  /* Messages you send sit at the inline end, as in WhatsApp. */
  .bubble-out {
    justify-self: end;
    background: color-mix(in oklab, var(--color-wa) 22%, var(--color-light));
    border-end-end-radius: 0.3rem;
    transform-origin: bottom right;
  }

  .bubble-in {
    justify-self: start;
    border-end-start-radius: 0.3rem;
    transform-origin: bottom left;
  }

  :global([dir='rtl']) .bubble-in {
    transform-origin: bottom right;
  }

  :global([dir='rtl']) .bubble-out {
    transform-origin: bottom left;
  }

  /* The conversation plays out as the steps beside it scroll past. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :global(#how) {
        timeline-scope: --journey;
      }

      :global(#how .steps) {
        view-timeline: --journey block;
      }

      :global(html:not(.a11y-still)) .bubble {
        animation: bubble-in linear both;
        animation-timeline: --journey;
        animation-range: entry calc(30% + var(--i) * 14%) entry calc(42% + var(--i) * 14%);
      }
    }
  }

  @keyframes bubble-in {
    from {
      opacity: 0;
      scale: 0.94;
      translate: 0 0.5rem;
      animation-timing-function: var(--ease-out);
    }
  }
</style>
