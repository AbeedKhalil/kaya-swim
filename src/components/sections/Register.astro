---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import SiteLinks from '../ui/SiteLinks.astro';
import WaterToggle from '../ui/WaterToggle.astro';
import { mailUrl, site, telUrl } from '../../config/site';
import { tracks, type TrackSlug } from '../../data/tracks';
import { getCopy, type Locale } from '../../i18n';
import { waLink } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
  /** Preselect this track (on track pages). */
  defaultTrack?: TrackSlug;
}

const { locale, defaultTrack } = Astro.props;
const t = getCopy(locale);
const r = t.register;
---

<!-- The close: the deep end again, the sign-up as a white pass floating in it, direct lines beside. -->
<section id="register" class="pool pool--live register on-dark section-pad relative" aria-labelledby="register-title">
  <span class="caustics" aria-hidden="true"></span>
  <span class="caustics caustics--spec-cool" aria-hidden="true"></span>

  <div class="wrap register-grid relative">
    <div class="pass on-light reveal">
      <form
        class="grid"
        method="get"
        action={`https://wa.me/${site.whatsapp}`}
        target="_blank"
        novalidate
        data-register
        data-wa={site.whatsapp}
        data-greeting={r.message.greeting}
        data-intro={r.message.intro}
        data-label-name={r.message.name}
        data-label-track={r.message.track}
        data-label-age={r.message.age}
        data-label-note={r.message.note}
      >
        <div class="pass-main grid gap-5">
          <div>
            <h2 id="register-title" class="head-section">{r.title}</h2>
            <p class="mt-3 max-w-[46ch] text-ink-2">{r.intro}</p>
          </div>

          <div class="field">
            <label for="reg-name" class="field-label">{r.fields.name}</label>
            <input id="reg-name" name="name" type="text" autocomplete="name" enterkeyhint="next" required class="field-input" aria-describedby="reg-name-error" />
            <p id="reg-name-error" class="field-error" hidden>{r.errors.name}</p>
          </div>

          <div class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_9rem]">
            <div class="field">
              <label for="reg-track" class="field-label">{r.fields.track}</label>
              <select id="reg-track" name="track" required class="field-input" aria-describedby="reg-track-error">
                <option value="" disabled selected={!defaultTrack}>{r.fields.trackPlaceholder}</option>
                {
                  tracks.map((track) => (
                    <option value={track.slug} selected={track.slug === defaultTrack}>
                      {t.tracks[track.slug].name}
                    </option>
                  ))
                }
                <option value="not-sure">{r.fields.trackNotSure}</option>
              </select>
              <p id="reg-track-error" class="field-error" hidden>{r.errors.track}</p>
            </div>

            <div class="field">
              <label for="reg-age" class="field-label">{r.fields.age}</label>
              <input
                id="reg-age"
                name="age"
                type="number"
                inputmode="numeric"
                min="1"
                max="120"
                required
                class="field-input"
                aria-describedby="reg-age-error"
              />
              <p id="reg-age-error" class="field-error" hidden>{r.errors.age}</p>
            </div>
          </div>

          <div class="field">
            <label for="reg-note" class="field-label">
              {r.fields.note}
              <span class="font-normal text-muted">({r.fields.optional})</span>
            </label>
            <textarea id="reg-note" name="note" rows="3" class="field-input resize-y"></textarea>
          </div>
        </div>

        <div class="pass-stub">
          <button type="submit" class="btn btn-wa btn-lg w-full sm:w-auto">
            <span class="wa-disc" aria-hidden="true"><BrandIcon name="whatsapp" size={22} /></span>
            {t.cta.send}
            <span class="sr-only">{t.cta.opensWhatsapp}</span>
          </button>
          <p class="text-sm text-muted">{r.privacy}</p>
        </div>
      </form>
    </div>

    <div class="reveal" style="--reveal-at: 10%">
      <h3 class="font-display text-title font-semibold text-light">{r.direct}</h3>
      <ul class="mt-6 grid gap-3">
        <li>
          <a href={waLink(t.whatsapp.general)} target="_blank" rel="noopener" data-cta="register-direct" class="contact-row">
            <span class="contact-icon bg-wa! text-wa-ink!"><BrandIcon name="whatsapp" size={22} /></span>
            <span>
              <span class="block font-semibold">WhatsApp</span>
              <span class="block text-ink-2" dir="ltr">{site.phone.display}</span>
            </span>
            <span class="sr-only">{t.cta.opensWhatsapp}</span>
          </a>
        </li>
        <li>
          <a href={telUrl} class="contact-row">
            <span class="contact-icon"><Icon name="phone" size={22} /></span>
            <span>
              <span class="block font-semibold">{t.cta.call}</span>
              <span class="block text-ink-2" dir="ltr">{site.phone.display}</span>
            </span>
          </a>
        </li>
        <li>
          <a href={mailUrl} class="contact-row">
            <span class="contact-icon"><Icon name="mail" size={22} /></span>
            <span class="min-w-0">
              <span class="block font-semibold">{t.cta.email}</span>
              <span class="block truncate text-ink-2" dir="ltr">{site.email}</span>
            </span>
          </a>
        </li>
      </ul>
      <SiteLinks locale={locale} placement="contact" variant="row" class="mt-3 grid gap-3" />
    </div>
  </div>

  <WaterToggle locale={locale} class="register-toggle" />
</section>

<style>
  /* The pool closes the page as it opened it: sunlit water at the top, the deep end below. */
  .register {
    background:
      radial-gradient(60% 40% at 50% 0%, color-mix(in oklab, var(--color-sun) 50%, transparent), transparent 70%),
      linear-gradient(180deg, var(--color-pool) 0%, var(--color-pool-2) 35%, var(--color-deep) 75%, var(--color-abyss) 100%);
    color: var(--color-light);
    /* The second basin of the page, cut into the plaster like the hero's. */
    margin-inline: var(--space-sm);
    margin-bottom: var(--space-sm);
    border-radius: var(--radius-basin);
    --tile-a: 20rem;
    --tile-b: 32rem;
    --caustic-color: var(--color-tile);
    --caustic-a: 0.3;
    --caustic-b: 0.16;
  }

  .register-grid {
    display: grid;
    gap: var(--space-2xl);
    padding-inline: max(var(--space-sm), calc(var(--gutter) - var(--space-sm)));
  }

  @media (width >= 30rem) {
    .register {
      margin-inline: var(--space-md);
      margin-bottom: var(--space-md);
    }

    .register-grid {
      padding-inline: max(var(--space-sm), calc(var(--gutter) - var(--space-md)));
    }
  }

  @media (width >= 64rem) {
    .register-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--space-3xl);
      align-items: start;
    }
  }

  /* A pass lying in the water: the fields, then a stub torn along a perforation.
     The notches are cut with masks, so the shadow comes from a drop-shadow on the whole pass. */
  .pass {
    filter: drop-shadow(var(--drop-shadow-deep)) drop-shadow(var(--drop-shadow-pass-near));
  }

  .pass-main,
  .pass-stub {
    background: var(--color-light);
    color: var(--color-ink);
  }

  .pass-main {
    padding: var(--space-lg) var(--space-lg) var(--space-xl);
    border-radius: var(--radius-card) var(--radius-card) 0 0;
    -webkit-mask:
      radial-gradient(circle 14px at 0 100%, transparent 13px, var(--color-ink) 14px),
      radial-gradient(circle 14px at 100% 100%, transparent 13px, var(--color-ink) 14px);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle 14px at 0 100%, transparent 13px, var(--color-ink) 14px),
      radial-gradient(circle 14px at 100% 100%, transparent 13px, var(--color-ink) 14px);
    mask-composite: intersect;
  }

  .pass-stub {
    display: grid;
    gap: var(--space-md);
    padding: var(--space-xl) var(--space-lg) var(--space-lg);
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    background-image: linear-gradient(to right, var(--color-rule) 50%, transparent 50%);
    background-size: 12px 1.5px;
    background-repeat: repeat-x;
    background-position: 0 0;
    -webkit-mask:
      radial-gradient(circle 14px at 0 0, transparent 13px, var(--color-ink) 14px),
      radial-gradient(circle 14px at 100% 0, transparent 13px, var(--color-ink) 14px);
    -webkit-mask-composite: source-in;
    mask:
      radial-gradient(circle 14px at 0 0, transparent 13px, var(--color-ink) 14px),
      radial-gradient(circle 14px at 100% 0, transparent 13px, var(--color-ink) 14px);
    mask-composite: intersect;
  }

  @media (width >= 40rem) {
    .pass-main {
      padding: var(--space-xl) var(--space-xl) var(--space-xl);
    }

    .pass-stub {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: var(--space-lg);
      padding: var(--space-xl);
    }
  }

  .field {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }

  .field-label {
    font-weight: 600;
  }

  .field-input {
    width: 100%;
    min-height: 3.5rem;
    padding: var(--space-sm) var(--space-md);
    border: 1.5px solid var(--color-muted);
    border-radius: var(--radius-inner);
    background: var(--color-light);
    color: var(--color-ink);
    font: inherit;
    font-size: max(16px, 1rem);
    transition: border-color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .field-input:hover {
      border-color: var(--color-ink-2);
    }
  }

  .field-input:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: -1px;
    border-color: var(--color-focus);
  }

  .field-input[aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .field-error {
    color: var(--color-error);
    font-size: 0.9375rem;
    font-weight: 600;
  }

  /* Bottom right in both languages: the accessibility button holds bottom left. */
  /* Top end corner, clear of the accessibility button and the booking bar. */
  :global(.register-toggle) {
    position: absolute;
    top: var(--space-md);
    inset-inline-end: var(--space-md);
  }
</style>

<script>
  // Builds a tidy WhatsApp message from the form; nothing is stored on the site.
  const form = document.querySelector<HTMLFormElement>('form[data-register]');

  if (form) {
    type Field = HTMLInputElement | HTMLSelectElement;
    const required = ['name', 'track', 'age'] as const;
    const field = (name: string) => form.elements.namedItem(name) as Field | HTMLTextAreaElement | null;
    const isValid = (el: Field) => el.checkValidity() && el.value.trim() !== '';

    const mark = (el: Field, ok: boolean) => {
      el.setAttribute('aria-invalid', String(!ok));
      const error = document.getElementById(`${el.id}-error`);
      if (error) error.hidden = ok;
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();

      let firstInvalid: Field | null = null;
      for (const name of required) {
        const el = field(name) as Field;
        const ok = isValid(el);
        mark(el, ok);
        if (!ok && !firstInvalid) firstInvalid = el;
      }
      if (firstInvalid) {
        firstInvalid.focus();
        return;
      }

      const data = form.dataset;
      const track = field('track') as HTMLSelectElement;
      const note = (field('note')?.value ?? '').trim();
      const lines = [
        data.greeting,
        data.intro,
        `• ${data.labelName}: ${(field('name') as Field).value.trim()}`,
        `• ${data.labelTrack}: ${track.selectedOptions[0]?.text.trim() ?? ''}`,
        `• ${data.labelAge}: ${(field('age') as Field).value.trim()}`,
      ];
      if (note) lines.push(`• ${data.labelNote}: ${note}`);

      const url = `https://wa.me/${data.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
      const opened = window.open(url, '_blank');
      if (opened) opened.opener = null;
      else window.location.href = url;
    });

    // Clear an error as soon as the field becomes valid.
    form.addEventListener('input', (event) => {
      const el = event.target as Field;
      if (el.getAttribute?.('aria-invalid') === 'true') mark(el, isValid(el));
    });
    form.addEventListener('change', (event) => {
      const el = event.target as Field;
      if (el.getAttribute?.('aria-invalid') === 'true') mark(el, isValid(el));
    });
  }
</script>
