---
import Icon from '../ui/Icon.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const v = getCopy(Astro.props.locale).values;
---

<section class="on-dark section-pad bg-ink text-white" aria-labelledby="values-title">
  <div class="wrap">
    <p class="eyebrow reveal text-pool">{v.eyebrow}</p>
    <h2 id="values-title" class="reveal mt-3 font-display text-display">{v.title}</h2>

    <ul class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
      {
        v.items.map((item, index) => (
          <li class="reveal" style={`--reveal-at: ${index * 10}%`}>
            <span class="value-icon grid size-14 place-items-center rounded-2xl bg-white/10 text-pool">
              <Icon name={item.icon} size={28} strokeWidth={1.75} />
            </span>
            <h3 class="mt-5 text-xl font-bold">{item.title}</h3>
            <p class="mt-2 text-white/80">{item.text}</p>
          </li>
        ))
      }
    </ul>

    <ul class="mt-16 flex flex-wrap gap-3">
      {
        v.promises.map((promise, index) => (
          <li class="reveal-pop flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 font-semibold" style={`--reveal-at: ${index * 7}%`}>
            <Icon name="check" size={18} strokeWidth={2.5} class="text-wa" />
            {promise}
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .value-icon {
    transition:
      background-color 0.4s var(--ease-out),
      rotate 0.6s var(--ease-spring);
  }

  @media (hover: hover) {
    li:hover > .value-icon {
      background: rgb(20 151 181 / 0.22);
      rotate: -6deg;
    }
  }
</style>
