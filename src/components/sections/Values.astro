---
import Icon from '../ui/Icon.astro';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const v = getCopy(Astro.props.locale).values;
---

<!-- Rows: the three words as the head, each one opened in a ruled row beside it. -->
<section class="section-pad" aria-labelledby="values-title">
  <div class="wrap values-grid">
    <div class="values-head">
      <h2 id="values-title" class="head-section reveal">{v.title}</h2>
      <ul class="reveal mt-8 grid gap-3" style="--reveal-at: 8%">
        {
          v.promises.map((promise) => (
            <li class="flex items-center gap-3 text-lg font-semibold">
              <Icon name="check" size={18} strokeWidth={2.25} class="text-accent" />
              {promise}
            </li>
          ))
        }
      </ul>
    </div>

    <dl class="values-rows">
      {
        v.items.map((item, index) => (
          <div class="value-row reveal" style={`--reveal-at: ${index * 6}%`}>
            <dt class="flex items-center gap-3 font-display text-title font-semibold">
              <Icon name={item.icon} size={26} strokeWidth={1.75} class="text-accent" />
              {item.title}
            </dt>
            <dd class="text-ink-2">{item.text}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .values-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  .values-rows {
    border-top: 1.5px solid var(--color-ink);
  }

  .value-row {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .value-row dd {
    max-width: 52ch;
  }

  @media (width >= 64rem) {
    .values-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3xl);
    }

    .value-row {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      gap: var(--space-xl);
      align-items: baseline;
      padding-block: var(--space-xl);
    }
  }
</style>
