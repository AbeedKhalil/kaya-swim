---
import { Picture } from 'astro:assets';
import AgeRange from '../ui/AgeRange.astro';
import Icon from '../ui/Icon.astro';
import WaterToggle from '../ui/WaterToggle.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import { site } from '../../config/site';
import { tracks } from '../../data/tracks';
import { getCopy, localizePath, type Locale } from '../../i18n';
import { getPhoto } from '../../lib/media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const hero = t.hero;
const portrait = getPhoto('founder-portrait');
---

<!-- Poster: the head on sunlit plaster; the pool bleeds off the end edge with the three lanes lying in it. -->
<section id="top" class="hero relative isolate" aria-labelledby="hero-title">
  <div class="pool pool--live hero-pool decor" aria-hidden="true">
    <span class="floor-stripe hero-stripe"></span>
    <span class="caustics"></span>
    <span class="caustics caustics--spec-cool"></span>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title" class="hero-title font-display">
        <span class="enter-rise block">{hero.line1}</span>
        <span class="enter-rise block" style="--enter-delay: 40ms">{hero.line2}</span>
      </h1>
      <p class="lead enter mt-6 md:mt-8" style="--enter-delay: 90ms">{hero.sub}</p>
      <div class="enter mt-8 flex flex-wrap items-center gap-3 md:mt-10" style="--enter-delay: 150ms">
        <WhatsAppButton locale={locale} cta="hero" size="lg" class="max-sm:w-full" />
        <a href="#tracks" class="btn btn-clear btn-lg max-sm:w-full">{t.cta.seeTracks}</a>
      </div>
    </div>

    <div class="hero-stage">
      <div class="hero-panel clear enter" style="--enter-delay: 220ms">
        <p class="flex items-center gap-3">
          <span class="avatar grid size-12 shrink-0 place-items-center overflow-hidden rounded-full">
            {
              portrait ? (
                <Picture src={portrait} alt="" formats={['avif', 'webp']} widths={[96, 144]} sizes="48px" class="size-full object-cover" />
              ) : (
                <Icon name="medal" size={22} strokeWidth={1.75} />
              )
            }
          </span>
          <span class="leading-snug">
            <strong class="block font-semibold">{site.founder[locale].full}</strong>
            <span class="block text-[0.9375rem] text-muted">{hero.credential}</span>
          </span>
        </p>

        <ul class="mt-4" aria-label={hero.lanesLabel}>
          {
            tracks.map((track) => (
              <li>
                <span class="lane-rope lane-rope--fine block" aria-hidden="true" />
                <a href={localizePath(`/tracks/${track.slug}/`, locale)} class="hero-lane group" data-astro-prefetch>
                  <span class="hero-lane-ages num font-display">
                    <AgeRange min={track.ages[0]} max={track.ages[1]} />
                  </span>
                  <span class="min-w-0 flex-1 leading-snug">
                    <span class="sr-only">{t.tracksSection.agesPrefix} </span>
                    <span class="block font-semibold">{t.tracks[track.slug].name}</span>
                  </span>
                  <Icon name="forward" size={20} class="hero-lane-arrow text-accent" />
                </a>
              </li>
            ))
          }
        </ul>

        <p class="mt-1 flex items-center gap-2 border-t border-rule pt-4 text-[0.9375rem] text-muted">
          <Icon name="map-pin" size={16} strokeWidth={2} class="text-accent" />
          {site.location[locale]}
        </p>
      </div>
    </div>
  </div>

  <WaterToggle locale={locale} class="hero-toggle" />
</section>

<style>
  .hero {
    --pool-gap: var(--space-xl);
  }

  .hero-grid {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-xl) var(--space-3xl);
  }

  .hero-title {
    font-size: var(--text-hero);
    font-weight: 300;
    line-height: 1;
    max-width: none;
  }

  .hero-copy .lead {
    max-width: 30ch;
  }

  /* The pool: a sunlit window of water, square to the end edge, rounded where it meets the plaster. */
  .hero-pool {
    position: absolute;
    z-index: -1;
    inset-inline: var(--space-lg) 0;
    bottom: 0;
    height: var(--pool-h, 26rem);
    border-start-start-radius: var(--radius-card);
    border-end-start-radius: 0;
    --tile-a: 18rem;
    --tile-b: 28rem;
    --caustic-a: 0.62;
    --caustic-b: 0.34;
  }

  .hero-stripe {
    inset-inline-end: 7%;
    top: -1rem;
    bottom: 3.5rem;
  }

  /* Between lanes a fine rope; it is the panel's only divider language besides the foot rule. */
  .hero-panel li + li .lane-rope {
    margin-block: var(--space-2xs);
  }

  .hero-panel li:first-child .lane-rope {
    --rope-a: var(--color-rule);
    --rope-b: transparent;
  }

  .hero-stage {
    display: grid;
    place-items: center;
    padding-inline: var(--space-sm);
  }

  .hero-panel {
    width: min(100%, 28rem);
    padding: var(--space-lg);
    box-shadow: var(--edge-light), var(--shadow-cast);
  }

  .avatar {
    color: var(--color-bronze);
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1.5px var(--color-bronze-light);
  }

  .hero-lane {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 4.25rem;
    padding-block: var(--space-xs);
    border-radius: var(--radius-inner);
    transition: background-color var(--dur-short) var(--ease-out);
  }

  .hero-lane-ages {
    flex-shrink: 0;
    min-width: 5.5ch;
    font-size: 2rem;
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-accent-hi);
  }

  .hero-lane :global(.hero-lane-arrow) {
    transition: translate var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-lane:hover {
      background: color-mix(in oklab, var(--color-accent-soft) 70%, transparent);
    }

    .hero-lane:hover :global(.hero-lane-arrow) {
      translate: calc(var(--dir, 1) * 4px) 0;
    }
  }

  .hero-lane:active {
    background: var(--color-accent-soft);
  }

  :global(.hero-toggle) {
    position: absolute;
    inset-inline-end: var(--space-md);
    bottom: var(--space-md);
  }

  /* Phones: the pool sits under the copy and the panel floats half in it. */
  @media (width < 60rem) {
    .hero {
      --pool-h: 24rem;
    }

    .hero-grid {
      gap: var(--space-xl);
      padding-block: var(--space-lg) var(--space-2xl);
    }
  }

  /* Desktop: copy on the start half, the pool and its lanes on the end half. */
  @media (width >= 60rem) {
    .hero {
      min-height: min(calc(100svh - var(--header-h)), 54rem);
      display: grid;
      align-items: center;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: center;
      padding-block: var(--space-2xl);
    }

    .hero-pool {
      inset-inline-start: calc(50% + var(--space-xl));
      inset-block: 0 var(--pool-gap);
      height: auto;
      border-end-start-radius: var(--radius-card);
    }

    .hero-stripe {
      bottom: 4rem;
    }

    .hero-stage {
      padding-inline: var(--space-2xl) 0;
      padding-bottom: var(--pool-gap);
    }

    :global(.hero-toggle) {
      bottom: calc(var(--pool-gap) + var(--space-md));
    }
  }

  /* On load the water rises into its window, then the panel settles on it. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.a11y-still)) .hero-pool {
      animation: pool-fill 0.9s var(--ease-out) both;
    }
  }

  @keyframes pool-fill {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
</style>
