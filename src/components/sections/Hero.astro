---
import { Picture } from 'astro:assets';
import AgeRange from '../ui/AgeRange.astro';
import Icon from '../ui/Icon.astro';
import MedalEmblem from '../ui/MedalEmblem.astro';
import WaterToggle from '../ui/WaterToggle.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import { site } from '../../config/site';
import { tracks } from '../../data/tracks';
import { getCopy, localizePath, type Locale } from '../../i18n';
import { getPhoto } from '../../lib/media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const hero = t.hero;
const portrait = getPhoto('founder-portrait');
---

<!--
  The deep end at noon: a pool basin cut into the plaster, sunlight netting the water.
  The head, one sentence and the WhatsApp action sit in the calm water; the three tracks
  lie below them as lanes, parted by lane ropes. The basin's colour is painted from the
  first frame; only the light on it arrives.
-->
<section id="top" class="hero relative isolate" aria-labelledby="hero-title">
  <div class="hero-basin on-dark">
    <div class="pool pool--live hero-water decor" aria-hidden="true">
      <span class="hero-sun"></span>
      <span class="floor-stripe hero-stripe"></span>
      <span class="caustics hero-caustics"></span>
      <span class="caustics caustics--spec-cool hero-caustics"></span>
    </div>

    <div class="wrap hero-grid">
      <div class="hero-copy">
        <h1 id="hero-title" class="hero-title font-display">
          <span class="enter-rise block">{hero.line1}</span>
          <span class="enter-rise block" style="--enter-delay: 40ms">{hero.line2}</span>
        </h1>
        <p class="hero-sub enter" style="--enter-delay: 90ms">{hero.sub}</p>
        <div class="hero-actions enter" style="--enter-delay: 150ms">
          <WhatsAppButton locale={locale} cta="hero" size="lg" class="hero-cta" />
          <a href="#tracks" class="btn btn-outline btn-lg hero-more">{t.cta.seeTracks}</a>
        </div>
      </div>

      <div class="hero-lanes enter" style="--enter-delay: 220ms">
        <p class="hero-who">
          <span class="hero-avatar">
            {
              portrait ? (
                <Picture src={portrait} alt="" formats={['avif', 'webp']} widths={[96, 144]} sizes="48px" class="size-full rounded-full object-cover" />
              ) : (
                <MedalEmblem disc uid="hero" class="size-full" />
              )
            }
          </span>
          <span class="min-w-0 leading-snug">
            <strong class="block font-semibold">{site.founder[locale].full}</strong>
            <span class="hero-who-line block">{hero.credential}</span>
          </span>
        </p>

        <ul class="hero-lane-list" aria-label={hero.lanesLabel}>
          {
            tracks.map((track) => (
              <li>
                <span class="lane-rope hero-rope block" aria-hidden="true" />
                <a href={localizePath(`/tracks/${track.slug}/`, locale)} class="hero-lane" data-astro-prefetch>
                  <span class="hero-lane-ages num font-display">
                    <AgeRange min={track.ages[0]} max={track.ages[1]} />
                  </span>
                  <span class="min-w-0 flex-1 leading-snug">
                    <span class="sr-only">{t.tracksSection.agesPrefix} </span>
                    <span class="block font-semibold">{t.tracks[track.slug].name}</span>
                  </span>
                  <span class="hero-lane-go" aria-hidden="true">
                    <Icon name="forward" size={18} strokeWidth={2.25} />
                  </span>
                </a>
              </li>
            ))
          }
        </ul>

        <p class="hero-where">
          <Icon name="map-pin" size={16} strokeWidth={2} />
          {site.location[locale]}
        </p>
      </div>
    </div>

    <WaterToggle locale={locale} class="hero-toggle" />
  </div>
</section>

<style>
  .hero {
    padding-inline: var(--basin-inset);
    --basin-inset: var(--space-sm);
  }

  /* The basin: painted deep from the first frame (so the light type is never on plaster),
     with a bright coping edge where the water meets the deck. */
  .hero-basin {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-radius: var(--radius-basin);
    background:
      linear-gradient(180deg, var(--color-pool) 0%, var(--color-pool-2) 42%, var(--color-deep) 78%, color-mix(in oklab, var(--color-deep) 70%, var(--color-abyss)) 100%);
    color: var(--color-light);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-light) 12%, transparent),
      inset 0 18px 30px -18px color-mix(in oklab, var(--color-abyss) 55%, transparent);
  }

  .hero-water {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: none;
    --tile-a: 17rem;
    --tile-b: 27rem;
    --caustic-color: var(--color-tile);
    --caustic-a: 0.34;
    --caustic-b: 0.2;
  }

  /* The sun stands up and to the end side: one warm-white pool of light, kept off the copy. */
  .hero-sun {
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 55% at 88% 0%, color-mix(in oklab, var(--color-sun) 55%, transparent), transparent 70%);
  }

  :global([dir='rtl']) .hero-sun {
    background: radial-gradient(70% 55% at 12% 0%, color-mix(in oklab, var(--color-sun) 55%, transparent), transparent 70%);
  }

  /* Calm water behind the words: the light net thins where the copy sits and runs full in the lanes. */
  .hero-caustics {
    -webkit-mask-image: linear-gradient(180deg, color-mix(in oklab, var(--color-black) 40%, transparent) 0%, color-mix(in oklab, var(--color-black) 30%, transparent) 45%, var(--color-black) 85%);
    mask-image: linear-gradient(180deg, color-mix(in oklab, var(--color-black) 40%, transparent) 0%, color-mix(in oklab, var(--color-black) 30%, transparent) 45%, var(--color-black) 85%);
  }

  .hero-stripe {
    inset-inline-end: 9%;
    top: -1rem;
    bottom: 3.5rem;
    width: 0.75rem;
    background: color-mix(in oklab, var(--color-abyss) 60%, transparent);
  }

  .hero-grid {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-lg);
    padding-inline: max(var(--space-lg), calc(var(--gutter) - var(--basin-inset)));
  }

  .hero-title {
    font-size: var(--text-hero);
    line-height: 0.98;
    letter-spacing: -0.035em;
    color: var(--color-light);
    max-width: none;
  }

  .hero-title:lang(he) {
    line-height: 1;
    letter-spacing: -0.01em;
  }

  .hero-sub {
    margin-top: var(--space-md);
    max-width: 32ch;
    font-size: var(--text-lead);
    line-height: 1.45;
    color: color-mix(in oklab, var(--color-light) 88%, var(--color-shade));
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .hero-actions :global(.hero-cta) {
    flex: 1 1 auto;
  }

  .hero-more {
    color: var(--color-light);
  }

  /* Phones: one action owns the row; the way down to the lanes is a quiet underlined link. */
  @media (width < 40rem) {
    .hero-actions :global(.hero-cta) {
      flex-basis: 100%;
    }

    .hero-more {
      min-height: 2.75rem;
      padding-inline: var(--space-xs);
      box-shadow: none;
      font-size: 1rem;
      text-decoration: underline;
      text-decoration-color: color-mix(in oklab, var(--color-light) 45%, transparent);
      text-underline-offset: 0.3em;
    }
  }

  /* The lanes: a panel of deep, still water so the light type reads at full strength. */
  .hero-lanes {
    width: 100%;
    padding: var(--space-md) var(--space-md) var(--space-sm);
    border-radius: 20px;
    background: color-mix(in oklab, var(--color-abyss) 62%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-light) 10%, transparent),
      var(--shadow-deep);
  }

  .hero-who {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding-bottom: var(--space-sm);
  }

  .hero-avatar {
    display: grid;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    filter: drop-shadow(var(--drop-shadow-deep));
  }

  .hero-who-line {
    font-size: 0.9375rem;
    color: var(--color-shade);
  }

  .hero-rope {
    --bead: 0.5rem;
    --rope-a: var(--color-tile);
    --rope-b: color-mix(in oklab, var(--color-light) 85%, transparent);
    filter: none;
  }

  .hero-lane {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    min-height: 4.25rem;
    margin-inline: calc(var(--space-xs) * -1);
    padding: var(--space-xs);
    border-radius: 14px;
    transition:
      background-color var(--dur-short) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .hero-lane-ages {
    flex-shrink: 0;
    min-width: 5.2ch;
    font-size: clamp(1.875rem, 1.2rem + 2.4vw, 2.25rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-tile);
  }

  .hero-lane-go {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--color-light) 12%, transparent);
    color: var(--color-light);
    transition:
      translate var(--dur-short) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero-lane:hover {
      background: color-mix(in oklab, var(--color-light) 8%, transparent);
    }

    .hero-lane:hover .hero-lane-go {
      translate: calc(var(--dir, 1) * 4px) 0;
      background: var(--color-light);
      color: var(--color-ink);
    }
  }

  /* Touch: the lane answers on pointer-down. */
  .hero-lane:active {
    background: color-mix(in oklab, var(--color-light) 14%, transparent);
    transform: scale(0.985);
    transition-duration: 60ms;
  }

  .hero-where {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-2xs);
    padding-top: var(--space-sm);
    border-top: 1px solid color-mix(in oklab, var(--color-light) 16%, transparent);
    font-size: 0.9375rem;
    color: var(--color-shade);
  }

  /* Pause control: top end corner of the basin, the one corner the copy never reaches. */
  :global(.hero-toggle) {
    position: absolute;
    top: var(--space-sm);
    inset-inline-end: var(--space-sm);
  }

  @media (width >= 30rem) {
    .hero {
      --basin-inset: var(--space-md);
    }
  }

  /* Tablet: the lanes sit beside each other's width, the copy gets a wider measure. */
  @media (width >= 40rem) {
    .hero-grid {
      padding-block: var(--space-2xl) var(--space-xl);
    }

    .hero-lanes {
      padding: var(--space-lg) var(--space-lg) var(--space-md);
    }

    .hero-actions :global(.hero-cta) {
      flex: 0 0 auto;
    }
  }

  /* Desktop: one panorama of water; copy on the start half, the lanes floating on the end half. */
  @media (width >= 60rem) {
    .hero {
      --basin-inset: var(--space-md);
    }

    .hero-basin {
      min-height: min(calc(100svh - var(--header-h) - var(--space-md)), 52rem);
      display: grid;
      align-items: center;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: center;
      gap: var(--space-3xl);
      padding-block: var(--space-3xl);
    }

    .hero-sub {
      margin-top: var(--space-lg);
    }

    .hero-actions {
      margin-top: var(--space-xl);
    }

    .hero-caustics {
      -webkit-mask-image: linear-gradient(90deg, color-mix(in oklab, var(--color-black) 30%, transparent) 0%, color-mix(in oklab, var(--color-black) 35%, transparent) 45%, var(--color-black) 70%);
      mask-image: linear-gradient(90deg, color-mix(in oklab, var(--color-black) 30%, transparent) 0%, color-mix(in oklab, var(--color-black) 35%, transparent) 45%, var(--color-black) 70%);
    }

    :global([dir='rtl']) .hero-caustics {
      -webkit-mask-image: linear-gradient(270deg, color-mix(in oklab, var(--color-black) 30%, transparent) 0%, color-mix(in oklab, var(--color-black) 35%, transparent) 45%, var(--color-black) 70%);
      mask-image: linear-gradient(270deg, color-mix(in oklab, var(--color-black) 30%, transparent) 0%, color-mix(in oklab, var(--color-black) 35%, transparent) 45%, var(--color-black) 70%);
    }

    .hero-lanes {
      max-width: 30rem;
      justify-self: end;
    }

    .hero-stripe {
      bottom: 4rem;
    }

    :global(.hero-toggle) {
      top: var(--space-md);
      inset-inline-end: var(--space-md);
    }
  }

  /* On load the sunlight switches on across the water: the net brightens from nothing in under a second. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.a11y-still)) .hero-water {
      animation: light-on 0.9s var(--ease-out) both;
    }
  }

  @keyframes light-on {
    from {
      opacity: 0;
    }
  }
</style>
