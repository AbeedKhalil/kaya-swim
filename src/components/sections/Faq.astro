---
import Icon from '../ui/Icon.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import type { TrackSlug } from '../../data/tracks';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Show only the questions tagged for this track. */
  track?: TrackSlug;
  title?: string;
  class?: string;
}

const { locale, track, title, class: className } = Astro.props;
const faq = getCopy(locale).faq;
const items = track ? faq.items.filter((item) => !item.tracks || item.tracks.includes(track)) : faq.items;
---

<section id="faq" class:list={['section-pad', className]} aria-labelledby="faq-title">
  <div class="wrap grid gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)] lg:gap-16">
    <div>
      <h2 id="faq-title" class="reveal font-display text-display">{title ?? faq.title}</h2>
      <p class="reveal mt-4 text-lg text-ink-soft">{faq.intro}</p>
      <WhatsAppButton locale={locale} cta="faq" class="mt-6" />
    </div>

    <div class="grid content-start gap-3">
      {
        items.map((item, index) => (
          <details name="faq" class="faq-item reveal contrast-border rounded-card bg-white" style={`--reveal-at: ${Math.min(index, 5) * 5}%`}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-card p-5 text-lg leading-snug font-bold">
              {item.q}
              <span class="faq-icon grid size-9 shrink-0 place-items-center rounded-full bg-shallow text-deep">
                <Icon name="plus" size={20} strokeWidth={2.25} />
              </span>
            </summary>
            <p class="px-5 pb-5 text-ink-soft">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary {
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq-icon {
    transition: rotate 0.25s var(--ease-water);
  }

  details[open] .faq-icon {
    rotate: 45deg;
  }

  .faq-item {
    transition:
      box-shadow 0.4s var(--ease-out),
      background-color 0.4s var(--ease-out);
  }

  .faq-item:hover,
  .faq-item[open] {
    box-shadow: var(--shadow-card);
  }

  /* Answers slide open where the browser can animate to "auto" height. */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 0.45s var(--ease-out),
        content-visibility 0.45s allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }
</style>
