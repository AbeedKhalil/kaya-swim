---
import Icon from '../ui/Icon.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import type { TrackSlug } from '../../data/tracks';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  /** Show only the questions tagged for this track. */
  track?: TrackSlug;
  title?: string;
  class?: string;
}

const { locale, track, title, class: className } = Astro.props;
const faq = getCopy(locale).faq;
const items = track ? faq.items.filter((item) => !item.tracks || item.tracks.includes(track)) : faq.items;
---

<!-- Rows: the head block holds its place while the questions run beside it. -->
<section id="faq" class:list={['section-pad', className]} aria-labelledby="faq-title">
  <div class="wrap faq-grid">
    <div class="faq-head">
      <h2 id="faq-title" class="head-section reveal">{title ?? faq.title}</h2>
      <p class="lead reveal mt-4">{faq.intro}</p>
      <WhatsAppButton locale={locale} cta="faq" class="reveal mt-8 max-sm:w-full" />
    </div>

    <div class="faq-list">
      {
        items.map((item) => (
          <details name="faq" class="faq-item">
            <summary class="faq-q">
              <span>{item.q}</span>
              <span class="faq-icon" aria-hidden="true">
                <Icon name="plus" size={18} strokeWidth={2} />
              </span>
            </summary>
            <p class="faq-a">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (width >= 64rem) {
    .faq-grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + var(--space-xl));
    }
  }

  .faq-list {
    border-top: 1.5px solid var(--color-ink);
  }

  .faq-item {
    border-bottom: 1px solid var(--color-rule);
  }

  .faq-q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 4.5rem;
    padding-block: var(--space-md);
    cursor: pointer;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
    transition: color var(--dur-short) var(--ease-out);
  }

  .faq-q::-webkit-details-marker {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .faq-q:hover {
      color: var(--color-accent-hi);
    }
  }

  .faq-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-accent-hi);
    transition:
      rotate var(--dur-short) var(--ease-out),
      scale var(--dur-micro) var(--ease-out),
      background-color var(--dur-short) var(--ease-out);
  }

  .faq-q:active .faq-icon {
    scale: 0.9;
  }

  details[open] .faq-icon {
    rotate: 45deg;
    background: var(--color-accent);
    color: var(--color-accent-ink);
  }

  .faq-a {
    max-width: 60ch;
    padding-bottom: var(--space-lg);
    color: var(--color-ink-2);
  }

  /* Answers slide open where the browser can animate to "auto" height (the one tolerated height animation). */
  @media (prefers-reduced-motion: no-preference) {
    .faq-item::details-content {
      block-size: 0;
      overflow-y: clip;
      transition:
        block-size 280ms var(--ease-out),
        content-visibility 280ms allow-discrete;
    }

    .faq-item[open]::details-content {
      block-size: auto;
    }
  }
</style>
