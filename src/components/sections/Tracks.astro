---
import LaneRope from '../ui/LaneRope.astro';
import TrackLane from './TrackLane.astro';
import { tracks } from '../../data/tracks';
import { getCopy, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
---

<!-- The pool from above: three lanes, shallow to deep to still, with lane ropes between them. -->
<section id="tracks" class="section-pad" aria-labelledby="tracks-title">
  <div class="wrap">
    <div class="tracks-head reveal">
      <h2 id="tracks-title" class="head-section">{t.tracksSection.title}</h2>
      <p class="lead">{t.tracksSection.intro}</p>
    </div>

    <div class="mt-12 grid gap-4 md:mt-16 md:gap-5">
      {
        tracks.map((track, index) => (
          <Fragment>
            {index > 0 && <LaneRope class="tracks-rope reveal-draw" />}
            <TrackLane locale={locale} track={track} index={index} />
          </Fragment>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tracks-head {
    display: grid;
    gap: var(--space-md);
  }

  /* The rope between two lanes: bolder beads than the panel ropes, running the lanes' full width. */
  .tracks-head + div :global(.tracks-rope) {
    --bead: 0.875rem;
    --rope-a: var(--color-accent);
    --rope-b: var(--color-light);
    margin-inline: var(--space-lg);
  }

  /* Head and line split across the row, baselines aligned. */
  @media (width >= 64rem) {
    .tracks-head {
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      align-items: end;
      gap: var(--space-2xl);
    }
  }
</style>
