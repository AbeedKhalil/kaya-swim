---
import AgeRange from '../ui/AgeRange.astro';
import Icon from '../ui/Icon.astro';
import LogoSlot from '../ui/LogoSlot.astro';
import WhatsAppButton from '../ui/WhatsAppButton.astro';
import type { Track, TrackSlug } from '../../data/tracks';
import { getCopy, localizePath, type Locale } from '../../i18n';
import { getLogo, type LogoSlot as LogoSlotName } from '../../lib/media';

interface Props {
  locale: Locale;
  track: Track;
  /** Position in the pool, for the staggered reveal. */
  index?: number;
}

const { locale, track, index = 0 } = Astro.props;
const t = getCopy(locale);
const copy = t.tracks[track.slug];
const dark = track.depth === 'deep';

/** Each lane carries its own programme's mark where one exists. */
const laneLogo: Record<TrackSlug, LogoSlotName> = {
  'water-experience': 'logo-kids',
  excellence: 'logo-main',
  'fear-of-water': 'logo-adults',
};
const logo = laneLogo[track.slug];
const hasLogo = Boolean(getLogo(logo));
---

<article
  class:list={[`depth-${track.depth}`, 'lane reveal contrast-border relative isolate overflow-hidden', dark && 'on-dark']}
  style={`--reveal-at: ${index * 6}%; view-transition-name: lane-${track.slug}; view-transition-class: lane`}
  aria-labelledby={`lane-${track.slug}`}
>
  <span class="floor-stripe lane-stripe decor" aria-hidden="true"></span>
  <span class="caustics" aria-hidden="true"></span>

  <div class="lane-ages">
    <p>
      <span class="lane-prefix block">{t.tracksSection.agesPrefix}</span>
      <span class="lane-figure num block font-display">
        <AgeRange min={track.ages[0]} max={track.ages[1]} />
      </span>
    </p>
    {
      hasLogo && (
        <span class="lane-logo">
          <LogoSlot slot={logo} label="SWIM" width={88} class="h-full w-auto" />
        </span>
      )
    }
  </div>

  <div class="lane-copy">
    <h3 id={`lane-${track.slug}`} class="lane-name font-display">{copy.name}</h3>
    <p class="lane-tagline mt-2">{copy.tagline}</p>
    <p class="lane-pitch mt-4">{copy.pitch}</p>
  </div>

  <div class="lane-offer">
    <ul class="grid gap-2.5">
      {
        copy.benefits.map((benefit) => (
          <li class="flex items-start gap-2.5">
            <Icon name="check" size={18} strokeWidth={2.25} class="lane-check mt-1" />
            <span>{benefit}</span>
          </li>
        ))
      }
    </ul>
    {copy.price && <p class="mt-6 text-lg font-semibold">{copy.price}</p>}
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <WhatsAppButton locale={locale} message={copy.whatsapp} cta={`track-${track.slug}`} class="max-sm:w-full" />
      <a href={localizePath(`/tracks/${track.slug}/`, locale)} class="link-forward lane-link" data-astro-prefetch>
        {t.cta.details}
        <Icon name="forward" size={18} />
      </a>
    </div>
  </div>
</article>

<style>
  /* A lane of the pool seen from above. On phones it runs almost edge to edge, like the hero basin,
     so the water and the age figure own the screen instead of sitting in a card. */
  .lane {
    display: grid;
    gap: var(--space-lg);
    margin-inline: calc(var(--space-sm) - var(--gutter));
    padding: var(--space-xl) var(--space-lg);
    border-radius: var(--radius-basin);
    box-shadow: inset 0 0 0 1px color-mix(in oklab, var(--color-light) 35%, transparent);
    --tile-a: 18rem;
    --tile-b: 28rem;
  }

  .depth-deep.lane {
    box-shadow:
      inset 0 0 0 1px color-mix(in oklab, var(--color-light) 10%, transparent),
      var(--shadow-deep);
  }

  .lane > :not(.caustics, .lane-stripe) {
    position: relative;
  }

  /* The black line on the pool floor, ending in its T: each lane has one. */
  .lane-stripe {
    inset-inline-end: 2.25rem;
    top: -1rem;
    bottom: 2.25rem;
    width: 0.625rem;
    z-index: auto;
    background: color-mix(in oklab, var(--color-deep) 18%, transparent);
  }

  .lane-stripe::after {
    width: 3.5rem;
    height: 0.625rem;
  }

  .depth-deep .lane-stripe {
    background: color-mix(in oklab, var(--color-abyss) 70%, transparent);
  }

  .lane-ages {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-md);
  }

  .lane-prefix {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink-2);
  }

  .lane-figure {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    font-size: clamp(5rem, 3rem + 8vw, 6.5rem);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  .depth-deep .lane-prefix {
    color: var(--color-shade);
  }

  .depth-deep .lane-figure {
    color: var(--color-tile);
  }

  .lane-logo {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 5rem;
    height: 5rem;
    padding: var(--space-xs);
    border-radius: 18px;
    background: var(--color-light);
    box-shadow: var(--shadow-chip);
    rotate: -4deg;
  }

  :global([dir='rtl']) .lane-logo {
    rotate: 4deg;
  }

  .lane-name {
    font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.25rem);
    line-height: 1.08;
    max-width: 20ch;
  }

  .lane-tagline {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--color-ink);
  }

  .lane-pitch {
    max-width: 46ch;
    color: var(--color-ink-2);
  }

  .lane-offer ul {
    font-weight: 500;
  }

  .lane :global(.lane-check) {
    color: var(--color-accent);
  }

  /* The deep end: light type on dark water. */
  .depth-deep .lane-tagline {
    color: var(--color-light);
  }

  .depth-deep .lane-pitch,
  .depth-deep .lane-offer ul {
    color: color-mix(in oklab, var(--color-light) 86%, var(--color-shade));
  }

  .depth-deep :global(.lane-check) {
    color: var(--color-tile);
  }

  .depth-deep .lane-link {
    color: var(--color-light);
  }

  .lane-link {
    color: var(--color-accent-hi);
  }

  @media (width >= 30rem) {
    .lane {
      margin-inline: calc(var(--space-md) - var(--gutter));
    }
  }

  @media (width >= 40rem) {
    .lane {
      margin-inline: 0;
      padding: var(--space-xl);
    }
  }

  @media (width >= 64rem) {
    .lane {
      grid-template-columns: minmax(0, 3fr) minmax(0, 5fr) minmax(0, 4fr);
      gap: var(--space-2xl);
      padding: var(--space-2xl) var(--space-2xl) var(--space-xl);
    }

    .lane-ages {
      flex-direction: column;
      align-items: flex-start;
      justify-content: space-between;
    }

    /* Desktop: the stripe runs in the lane's end margin, clear of all three columns. */
    .lane-stripe {
      inset-inline-end: 1.5rem;
    }
  }
</style>
