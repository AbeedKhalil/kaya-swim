---
import MediaSlot from '../ui/MediaSlot.astro';
import MedalEmblem from '../ui/MedalEmblem.astro';
import { site } from '../../config/site';
import { getCopy, type Locale } from '../../i18n';
import { getPhoto } from '../../lib/media';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getCopy(locale);
const f = t.founder;
// A real portrait keeps its 4:5; the water stand-in is shorter on phones so the story starts sooner.
const hasPortrait = Boolean(getPhoto('founder-portrait'));
---

<!-- The one chapter the page reads like a letter: the portrait held beside the story, the timeline on the pool floor. -->
<section id="story" class="section-pad-l bg-paper-2" aria-labelledby="story-title">
  <div class="wrap story-grid">
    <div class="story-portrait">
      <MediaSlot
        slot="founder-portrait"
        alt={f.portraitAlt}
        aspect={hasPortrait ? '4 / 5' : '5 / 4'}
        sizes="(min-width: 1024px) 34vw, 100vw"
        depth="deep"
        class="story-photo reveal-wipe rounded-card"
      >
        <span class="floor-stripe story-stripe"></span>
        <span class="story-name absolute inset-x-0 bottom-0 p-6 sm:p-8">
          <span class="block font-display text-[clamp(2.5rem,9vw,3.75rem)] leading-[0.95] font-semibold">{site.founder[locale].full}</span>
          <span class="mt-3 block font-semibold text-tile">{t.hero.credential}</span>
        </span>
      </MediaSlot>
    </div>

    <div class="story-text">
      <h2 id="story-title" class="head-section reveal">{f.title}</h2>
      <p class="story-lead reveal mt-6">{f.lead}</p>
      <div class="story-prose mt-8 grid gap-5">
        {f.paragraphs.map((paragraph) => <p class="reveal">{paragraph}</p>)}
      </div>

      <ol class="timeline mt-14 md:mt-16" aria-label={f.timelineLabel}>
        {
          f.timeline.map((item, index) => (
            <li class:list={['timeline-item reveal', item.medal && 'timeline-item--medal']} style={`--reveal-at: ${5 + index * 5}%`}>
              <span class="timeline-marker">
                {item.age !== undefined ? (
                  <Fragment>
                    <span class="block text-sm font-semibold text-muted">{f.agePrefix}</span>
                    <span class="timeline-age num block font-display">{item.age}</span>
                  </Fragment>
                ) : (
                  <span class="timeline-age timeline-word block pt-5 font-display">{item.label}</span>
                )}
              </span>
              <span class="timeline-text">
                {item.text}
                {item.medal && <MedalEmblem disc uid="story" class="timeline-medal" />}
              </span>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    gap: var(--space-2xl);
  }

  @media (width >= 64rem) {
    .story-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--space-3xl);
      align-items: start;
    }

    .story-portrait :global(.story-photo) {
      aspect-ratio: 4 / 5 !important;
    }

    .story-portrait {
      position: sticky;
      top: calc(var(--header-h) + var(--space-lg));
    }
  }

  /* The fallback portrait is the deep end with her name on it; a real photo replaces the whole slot. */
  .story-photo {
    color: var(--color-light);
    box-shadow: var(--shadow-deep);
  }

  .story-stripe {
    inset-inline-start: 22%;
    top: -1rem;
    bottom: 42%;
    background: color-mix(in oklab, var(--color-abyss) 70%, transparent);
  }

  .story-name {
    background: linear-gradient(0deg, color-mix(in oklab, var(--color-abyss) 85%, transparent), transparent);
    padding-top: var(--space-3xl);
  }

  .story-lead {
    font-family: var(--font-display);
    font-size: var(--text-statement);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.015em;
    max-width: 30ch;
    color: var(--color-ink);
  }

  .story-lead:lang(he) {
    font-weight: 600;
  }

  .story-prose {
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.75;
    color: var(--color-ink-2);
  }

  /* The black lane stripe on the pool floor, ending in a T at the wall: today. */
  .timeline {
    position: relative;
    display: grid;
    /* Items share one marker column, wide enough for the word that ends the timeline. */
    grid-template-columns: minmax(4.5rem, max-content) minmax(0, 1fr);
    gap: var(--space-lg) var(--space-md);
    padding-inline-start: 2.5rem;
  }

  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
  }

  .timeline::before {
    inset-inline-start: 0.5rem;
    top: 0.75rem;
    bottom: 1.6rem;
    width: 0.375rem;
  }

  .timeline::after {
    inset-inline-start: -0.25rem;
    bottom: 1.6rem;
    width: 1.875rem;
    height: 0.375rem;
  }

  .timeline-item {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: start;
  }

  .timeline-age {
    font-size: 2.75rem;
    font-weight: 500;
    color: var(--color-accent);
    line-height: 0.9;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .timeline-text {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding-top: 1.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
  }

  .timeline-item--medal .timeline-age,
  .timeline-item--medal .timeline-text {
    color: var(--color-bronze);
  }

  .timeline-item--medal .timeline-text {
    font-weight: 600;
  }

  .timeline :global(.timeline-medal) {
    width: 3.25rem;
    height: 3.25rem;
    flex-shrink: 0;
    margin-top: -0.75rem;
    filter: drop-shadow(var(--drop-shadow-medal));
  }

  /* Phones: a tighter stripe, so the word that ends the timeline leaves the text its measure. */
  @media (width < 40rem) {
    .timeline {
      column-gap: var(--space-sm);
      padding-inline-start: 2rem;
    }

    .timeline::before {
      inset-inline-start: 0.25rem;
    }

    .timeline::after {
      inset-inline-start: -0.5rem;
    }

    .timeline-word {
      font-size: 2.25rem;
    }

    .timeline :global(.timeline-medal) {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* As the timeline scrolls in, the stripe draws down, the T lands at the wall,
     and a band of light crosses the medal once. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .timeline {
        view-timeline: --story block;
      }

      :global(html:not(.a11y-still)) .timeline::before {
        transform-origin: top;
        animation: stripe-draw linear both;
        animation-timeline: --story;
        animation-range: entry 20% cover 50%;
      }

      :global(html:not(.a11y-still)) .timeline::after {
        animation: t-land linear both;
        animation-timeline: --story;
        animation-range: cover 45% cover 55%;
      }

      :global(html:not(.a11y-still)) .timeline-item--medal :global(.medal-sheen) {
        animation: sheen linear both;
        animation-timeline: --story;
        animation-range: cover 30% cover 55%;
      }
    }
  }

  @keyframes stripe-draw {
    from {
      scale: 1 0;
    }
  }

  @keyframes t-land {
    from {
      scale: 0 1;
    }
  }

  @keyframes sheen {
    from {
      translate: -40px 0;
    }
    to {
      translate: 190px 0;
    }
  }
</style>
