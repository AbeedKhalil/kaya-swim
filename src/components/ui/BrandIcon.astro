---
/**
 * Brand glyphs. WhatsApp appears many times per page, so it is drawn once as a
 * <symbol> (see BrandIconSprite) and referenced; the others are inlined.
 */
import { brandIcons, type BrandIconName } from '../../lib/brand-icons';

interface Props {
  name: BrandIconName;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="currentColor"
  aria-hidden="true"
  focusable="false"
  class:list={['shrink-0', className]}
>
  {name === 'whatsapp' ? <use href="#brand-whatsapp"></use> : <path d={brandIcons[name]}></path>}
</svg>
