---
/** Lane-rope floats between swimming lanes (decorative). */
interface Props {
  /** A finer rope, for dividers inside a panel. */
  fine?: boolean;
  class?: string;
}

const { fine = false, class: className } = Astro.props;
---

<div aria-hidden="true" class:list={['lane-rope', fine && 'lane-rope--fine', className]}></div>
