---
/**
 * Katrin's Maccabiah bronze (decorative). `disc` draws the medal alone; the full
 * emblem hangs it from its ribbon. A band of light can sweep across the bronze
 * (the .medal-sheen group; the parent decides when).
 */
interface Props {
  disc?: boolean;
  class?: string;
}

const { disc = false, class: className } = Astro.props;
const id = disc ? 'medal-disc' : 'medal-full';
---

<svg viewBox={disc ? '22 206 116 116' : '0 0 160 320'} class:list={['medal', className]} aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={`${id}-rim`} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--color-bronze-1)"></stop>
      <stop offset="0.45" style="stop-color: var(--color-bronze-2)"></stop>
      <stop offset="1" style="stop-color: var(--color-bronze-3)"></stop>
    </linearGradient>
    <radialGradient id={`${id}-face`} cx="0.36" cy="0.3" r="0.8">
      <stop offset="0" style="stop-color: var(--color-bronze-1)"></stop>
      <stop offset="0.55" style="stop-color: var(--color-bronze-2)"></stop>
      <stop offset="1" style="stop-color: var(--color-bronze)"></stop>
    </radialGradient>
    <linearGradient id={`${id}-sheen`} x1="0" y1="0" x2="1" y2="0">
      <stop offset="0" style="stop-color: var(--color-light); stop-opacity: 0"></stop>
      <stop offset="0.5" style="stop-color: var(--color-light); stop-opacity: 0.75"></stop>
      <stop offset="1" style="stop-color: var(--color-light); stop-opacity: 0"></stop>
    </linearGradient>
    <clipPath id={`${id}-clip`}>
      <circle cx="80" cy="264" r="54"></circle>
    </clipPath>
  </defs>

  {
    !disc && (
      <g>
        <path d="M20 0h36l34 192H66z" style="fill: var(--color-accent)" />
        <path d="M34.4 0h7.2l38.8 192h-4.8z" style="fill: var(--color-light)" opacity="0.92" />
        <path d="M104 0h36L94 192H70z" style="fill: var(--color-accent-hi)" />
        <path d="M118.4 0h7.2L84.4 192h-4.8z" style="fill: var(--color-light)" opacity="0.92" />
        <rect x="64" y="186" width="32" height="14" rx="4" fill={`url(#${id}-rim)`} />
        <circle cx="80" cy="207" r="6.5" fill="none" stroke={`url(#${id}-rim)`} stroke-width="3.5" />
      </g>
    )
  }

  <circle cx="80" cy="264" r="54" fill={`url(#${id}-rim)`}></circle>
  <circle cx="80" cy="264" r="46" fill={`url(#${id}-face)`}></circle>
  <circle cx="80" cy="264" r="40.5" fill="none" style="stroke: var(--color-bronze-3)" stroke-opacity="0.35" stroke-width="1.5"></circle>
  <text x="80" y="276" text-anchor="middle" class="medal-year" style="fill: var(--color-bronze-3)">2017</text>
  <g clip-path={`url(#${id}-clip)`}>
    <rect class="medal-sheen" x="-20" y="200" width="44" height="130" fill={`url(#${id}-sheen)`} transform="skewX(-18)"></rect>
  </g>
</svg>

<style>
  .medal-year {
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 400;
  }

  .medal-sheen {
    translate: -40px 0;
  }
</style>
