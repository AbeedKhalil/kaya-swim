---
import BrandIcon from '../ui/BrandIcon.astro';
import { getCopy, type Locale } from '../../i18n';
import { waLink } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<!--
  The booking bar. Phones: a full-width bar at the thumb, clear of the home indicator.
  Desktop: a pill at the bottom end corner. It waits until the hero's own action has
  scrolled away (a class set by the script below); without script it is simply there.
-->
<div class="wa-bar">
  <a href={waLink(t.whatsapp.general)} target="_blank" rel="noopener" data-cta="float" class="btn btn-wa wa-bar-button">
    <span class="wa-disc" aria-hidden="true"><BrandIcon name="whatsapp" size={20} /></span>
    <span>{t.cta.whatsapp}</span>
    <span class="sr-only">{t.cta.opensWhatsapp}</span>
  </a>
</div>

<style>
  .wa-bar {
    view-transition-name: wa-bar;
    position: fixed;
    z-index: var(--z-sticky);
    inset-inline: 0;
    bottom: 0;
    padding: var(--space-sm) var(--gutter) max(var(--space-sm), env(safe-area-inset-bottom, 0px));
    /* Room for the accessibility button, which sits bottom-left in both languages. */
    padding-left: calc(var(--space-md) + 3.5rem);
    background: color-mix(in oklab, var(--color-paper) 94%, transparent);
    box-shadow: 0 -1px 0 var(--color-rule);
    transition:
      translate var(--dur-short) var(--ease-out),
      opacity var(--dur-short) var(--ease-out),
      visibility 0s linear;
  }

  .wa-bar-button {
    width: 100%;
  }

  /* Hidden while the hero's action is on screen. */
  :global(html.js:not(.past-hero)) .wa-bar {
    translate: 0 110%;
    opacity: 0;
    visibility: hidden;
    transition:
      translate 160ms var(--ease-out),
      opacity 160ms var(--ease-out),
      visibility 0s linear 160ms;
  }

  @media (width >= 48rem) {
    .wa-bar {
      inset-inline: auto var(--space-lg);
      bottom: max(var(--space-lg), env(safe-area-inset-bottom, 0px));
      padding: 0;
      background: none;
      box-shadow: none;
    }

    .wa-bar-button {
      width: auto;
      box-shadow: var(--shadow-press), var(--shadow-float);
    }

    /* Hebrew: the end corner is bottom left, where the accessibility button sits; step past it. */
    :global([dir='rtl']) .wa-bar {
      inset-inline-end: calc(var(--space-lg) + 2.75rem + var(--space-sm));
    }
  }

  /* While the sign-up form is on screen, its own button is the action. */
  :global(html.at-register) .wa-bar {
    translate: 0 110%;
    opacity: 0;
    visibility: hidden;
  }
</style>

<script>
  // Show the bar once the hero has scrolled away; hide it again over the sign-up form.
  const root = document.documentElement;
  const hero = document.querySelector('.hero, [data-hero]');
  const register = document.getElementById('register');

  if (hero) {
    new IntersectionObserver(([entry]) => root.classList.toggle('past-hero', !entry.isIntersecting), {
      rootMargin: '0px 0px -40% 0px',
    }).observe(hero);
  } else {
    root.classList.add('past-hero');
  }

  if (register) {
    new IntersectionObserver(([entry]) => root.classList.toggle('at-register', entry.isIntersecting), {
      threshold: 0.25,
    }).observe(register);
  }
</script>
