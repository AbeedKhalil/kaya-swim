---
import BrandIcon from '../ui/BrandIcon.astro';
import { getCopy, type Locale } from '../../i18n';
import { waLink } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
}

const t = getCopy(Astro.props.locale);
---

<!-- Bottom-right in both languages: the thumb's natural reach on a phone. -->
<a
  href={waLink(t.whatsapp.general)}
  target="_blank"
  rel="noopener"
  data-cta="float"
  class="wa-float fixed z-50 grid size-14 place-items-center rounded-full bg-wa text-ink"
  aria-label={`${t.cta.whatsapp} ${t.cta.opensWhatsapp}`}
>
  <BrandIcon name="whatsapp" size={30} class="wa-glyph" />
  <span class="wa-label" aria-hidden="true">{t.cta.whatsapp}</span>
</a>

<style>
  .wa-float {
    view-transition-name: wa-float;
    right: 1rem;
    bottom: max(1rem, env(safe-area-inset-bottom));
    box-shadow:
      0 0 0 3px rgb(255 255 255 / 0.9),
      0 14px 30px -10px rgb(11 34 48 / 0.6);
    transition: transform 0.5s var(--ease-spring);
  }

  /* Ripples spreading on the water, a few times after the page loads. */
  .wa-float::before,
  .wa-float::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    border: 2px solid var(--color-wa);
    opacity: 0;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html:not(.a11y-still)) .wa-float::before {
      animation: wa-ripple 2.6s var(--ease-out) 2.5s 3;
    }

    :global(html:not(.a11y-still)) .wa-float::after {
      animation: wa-ripple 2.6s var(--ease-out) 3.3s 3;
    }
  }

  @keyframes wa-ripple {
    0% {
      scale: 1;
      opacity: 0.75;
    }
    80%,
    100% {
      scale: 1.9;
      opacity: 0;
    }
  }

  /* A label slides out beside the button on hover and focus (desktop). */
  .wa-label {
    position: absolute;
    right: calc(100% + 0.75rem);
    top: 50%;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--color-ink);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    white-space: nowrap;
    opacity: 0;
    translate: 0.5rem -50%;
    pointer-events: none;
    transition:
      opacity 0.3s var(--ease-out),
      translate 0.45s var(--ease-spring);
  }

  @media (hover: hover) {
    .wa-float:hover {
      transform: scale(1.06);
    }

    .wa-float:hover .wa-label,
    .wa-float:focus-visible .wa-label {
      opacity: 1;
      translate: 0 -50%;
    }
  }

  .wa-float :global(.wa-glyph) {
    transition: rotate 0.5s var(--ease-spring);
  }

  .wa-float:hover :global(.wa-glyph) {
    rotate: -12deg;
  }
</style>
