---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import LogoSlot from '../ui/LogoSlot.astro';
import SiteLinks from '../ui/SiteLinks.astro';
import { mailUrl, site, telUrl } from '../../config/site';
import { getCopy, localizePath, otherLocale, type Locale } from '../../i18n';
import { getLogo } from '../../lib/media';
import { waLink } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = getCopy(locale);
const other = otherLocale(locale);
const year = new Date().getFullYear();
const hasMainLogo = Boolean(getLogo('logo-main'));

const links = [
  { href: localizePath('/#tracks', locale), label: t.nav.tracks },
  { href: localizePath('/#story', locale), label: t.nav.story },
  { href: localizePath('/#how', locale), label: t.nav.how },
  { href: localizePath('/#faq', locale), label: t.nav.faq },
  { href: localizePath('/#register', locale), label: t.nav.contact },
];
---

<footer class="on-dark overflow-hidden bg-abyss text-light">
  <div class="wrap grid gap-12 pt-(--section-gap-s) pb-16 md:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)_minmax(0,1.2fr)]">
    <div>
      {
        hasMainLogo ? (
          <span class="inline-grid size-28 place-items-center rounded-(--radius-card) bg-light p-2.5">
            <LogoSlot slot="logo-main" label="SWIM" alt={site.brand} width={92} class="h-full w-auto" />
          </span>
        ) : (
          <span class="font-display text-[2.4rem] leading-none" dir="ltr">
            KAYA SWIM
          </span>
        )
      }
      <p class="mt-5 max-w-xs text-shade">{t.footer.tagline}</p>
      <p class="mt-4 flex items-center gap-2 text-shade">
        <Icon name="map-pin" size={18} />
        {site.location[locale]}
      </p>
    </div>

    <nav aria-labelledby="footer-nav-title">
      <h2 id="footer-nav-title" class="min-w-0 text-sm wrap-break-word text-shade-2">{t.footer.navTitle}</h2>
      <ul class="mt-4 grid gap-2 pointer-coarse:mt-2 pointer-coarse:gap-0">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="foot-link">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="min-w-0 text-sm wrap-break-word text-shade-2">{t.footer.contactTitle}</h2>
      <ul class="mt-4 grid gap-3 pointer-coarse:mt-2 pointer-coarse:gap-0">
        <li>
          <a href={waLink(t.whatsapp.general)} target="_blank" rel="noopener" data-cta="footer" class="foot-link inline-flex items-center gap-3">
            <BrandIcon name="whatsapp" size={20} class="text-wa" />
            <span>{t.cta.whatsapp}</span>
            <span class="sr-only">{t.cta.opensWhatsapp}</span>
          </a>
        </li>
        <li>
          <a href={telUrl} class="foot-link inline-flex items-center gap-3">
            <Icon name="phone" size={20} class="text-shade" />
            <span dir="ltr">{site.phone.display}</span>
          </a>
        </li>
        <li>
          <a href={mailUrl} class="foot-link inline-flex items-center gap-3">
            <Icon name="mail" size={20} class="text-shade" />
            <span dir="ltr">{site.email}</span>
          </a>
        </li>
      </ul>
      <SiteLinks locale={locale} placement="footer" variant="list" class="mt-3 grid gap-3 pointer-coarse:mt-0 pointer-coarse:gap-0" iconClass="text-shade" linkClass="foot-link inline-flex items-center gap-3" />
    </div>
  </div>

  <!-- The brand name fills with water as the page reaches its end (decorative). -->
  <div class="footer-mark decor wrap" aria-hidden="true">
    <span class="footer-mark-text" data-text="KAYA SWIM" dir="ltr">KAYA SWIM</span>
  </div>

  <div class="border-t border-light/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6 pb-28 text-sm text-shade md:pb-24">
      <p>© {year} KAYA SWIM, {t.footer.rights}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href={localizePath('/accessibility/', locale)} class="foot-link">{t.footer.accessibility}</a></li>
        <li>
          <a href={localizePath(path, other)} lang={other} hreflang={other} class="foot-link">
            {getCopy(other).languageName}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  @property --fill {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 38%;
  }

  :global(.foot-link) {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color var(--dur-short) var(--ease-out);
  }

  :global(.foot-link:hover) {
    text-decoration-color: currentColor;
  }

  /* Touch: every footer link is a full 44px row; the list gaps close up to compensate. */
  @media (pointer: coarse) {
    :global(.foot-link) {
      display: inline-flex;
      align-items: center;
      min-height: 2.75rem;
    }
  }

  .footer-mark {
    padding-bottom: var(--space-lg);
  }

  .footer-mark-text {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4rem, 17vw, 16rem);
    font-weight: 300;
    line-height: 0.9;
    letter-spacing: -0.02em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1px color-mix(in oklab, var(--color-light) 22%, transparent);
  }

  /* The same letters, filled with sunlit pool water up to --fill. */
  .footer-mark-text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    -webkit-text-stroke: 0;
    background:
      linear-gradient(180deg, color-mix(in oklab, var(--color-shade) 70%, transparent), color-mix(in oklab, var(--color-deep) 85%, transparent) 80%),
      url('../../assets/art/caustics.svg') 0 0 / 12rem,
      var(--color-shade-2);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    clip-path: inset(var(--fill) -0.1em -0.1em -0.1em);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .footer-mark {
        view-timeline: --mark block;
      }

      :global(html:not(.a11y-still)) .footer-mark-text::after {
        animation: fill-rise linear both;
        animation-timeline: --mark;
        animation-range: entry 10% entry 100%;
      }
    }
  }

  @keyframes fill-rise {
    from {
      --fill: 100%;
    }
    to {
      --fill: 38%;
    }
  }
</style>
