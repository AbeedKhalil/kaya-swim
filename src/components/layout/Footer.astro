---
import BrandIcon from '../ui/BrandIcon.astro';
import Icon from '../ui/Icon.astro';
import LogoSlot from '../ui/LogoSlot.astro';
import SiteLinks from '../ui/SiteLinks.astro';
import { mailUrl, site, telUrl } from '../../config/site';
import { getCopy, localizePath, otherLocale, type Locale } from '../../i18n';
import { getLogo } from '../../lib/media';
import { waLink } from '../../lib/whatsapp';

interface Props {
  locale: Locale;
  path: string;
}

const { locale, path } = Astro.props;
const t = getCopy(locale);
const other = otherLocale(locale);
const year = new Date().getFullYear();
const hasMainLogo = Boolean(getLogo('logo-main'));

const links = [
  { href: localizePath('/#tracks', locale), label: t.nav.tracks },
  { href: localizePath('/#story', locale), label: t.nav.story },
  { href: localizePath('/#how', locale), label: t.nav.how },
  { href: localizePath('/#faq', locale), label: t.nav.faq },
  { href: localizePath('/#register', locale), label: t.nav.contact },
];
---

<footer class="on-dark overflow-hidden bg-ink text-white">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.5fr_1fr_1.2fr]">
    <div>
      {
        hasMainLogo ? (
          <span class="inline-grid size-28 place-items-center rounded-2xl bg-white p-2.5">
            <LogoSlot slot="logo-main" label="SWIM" alt={site.brand} width={92} class="h-full w-auto" />
          </span>
        ) : (
          <span class="font-display text-[2.4rem] leading-none tracking-[0.08em]" dir="ltr">
            KAYA SWIM
          </span>
        )
      }
      <p class="mt-4 max-w-xs text-white/75">{t.footer.tagline}</p>
      <p class="mt-4 flex items-center gap-2 text-white/75">
        <Icon name="map-pin" size={18} class="text-pool" />
        {site.location[locale]}
      </p>
    </div>

    <nav aria-labelledby="footer-nav-title">
      <h2 id="footer-nav-title" class="text-sm font-bold text-white/60">{t.footer.navTitle}</h2>
      <ul class="mt-4 grid gap-2">
        {
          links.map((link) => (
            <li>
              <a href={link.href} class="hover:text-wa">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="text-sm font-bold text-white/60">{t.footer.contactTitle}</h2>
      <ul class="mt-4 grid gap-3">
        <li>
          <a href={waLink(t.whatsapp.general)} target="_blank" rel="noopener" data-cta="footer" class="inline-flex items-center gap-3 hover:text-wa">
            <BrandIcon name="whatsapp" size={20} class="text-wa" />
            <span>{t.cta.whatsapp}</span>
            <span class="sr-only">{t.cta.opensWhatsapp}</span>
          </a>
        </li>
        <li>
          <a href={telUrl} class="inline-flex items-center gap-3 hover:text-wa">
            <Icon name="phone" size={20} class="text-pool" />
            <span dir="ltr">{site.phone.display}</span>
          </a>
        </li>
        <li>
          <a href={mailUrl} class="inline-flex items-center gap-3 hover:text-wa">
            <Icon name="mail" size={20} class="text-pool" />
            <span dir="ltr">{site.email}</span>
          </a>
        </li>
      </ul>
      <SiteLinks locale={locale} placement="footer" variant="list" class="mt-3 grid gap-3" iconClass="text-pool" />
    </div>
  </div>

  <!-- The brand name fills with water as the page reaches its end (decorative). -->
  <div class="footer-mark decor wrap" aria-hidden="true">
    <span class="footer-mark-text" data-text="KAYA SWIM" dir="ltr">KAYA SWIM</span>
  </div>

  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-3 pt-6 pb-24 text-sm text-white/70 md:pb-6">
      <p>© {year} KAYA SWIM · {t.footer.rights}</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a href={localizePath('/accessibility/', locale)} class="underline-offset-4 hover:text-white hover:underline">{t.footer.accessibility}</a></li>
        <li>
          <a href={localizePath(path, other)} lang={other} hreflang={other} class="underline-offset-4 hover:text-white hover:underline">
            {getCopy(other).languageName}
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<style>
  @property --fill {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 40%;
  }

  .footer-mark {
    padding-bottom: 1.5rem;
  }

  .footer-mark-text {
    position: relative;
    display: block;
    font-family: var(--font-display);
    font-size: clamp(4.5rem, 21vw, 19rem);
    line-height: 0.8;
    letter-spacing: 0.04em;
    text-align: center;
    white-space: nowrap;
    color: transparent;
    -webkit-text-stroke: 1.5px rgb(255 255 255 / 0.16);
  }

  /* The same letters, filled with pool water up to --fill. */
  .footer-mark-text::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    -webkit-text-stroke: 0;
    /* A translucent water tint over the caustic net, so the lines read as soft light. */
    background:
      linear-gradient(180deg, rgb(20 151 181 / 0.82), rgb(10 88 114 / 0.9) 75%),
      url('../../assets/art/caustics.svg') 0 0 / 14rem,
      var(--color-deep);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    clip-path: inset(var(--fill) -0.1em -0.1em -0.1em);
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .footer-mark {
        view-timeline: --mark block;
      }

      :global(html:not(.a11y-still)) .footer-mark-text::after {
        animation: fill-rise linear both;
        animation-timeline: --mark;
        animation-range: entry 10% entry 100%;
      }
    }
  }

  @keyframes fill-rise {
    from {
      --fill: 100%;
    }
    to {
      --fill: 40%;
    }
  }
</style>
